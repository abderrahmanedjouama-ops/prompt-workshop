# Lithium Club - Prompt Engineering Workshop Environment Variables
# ═════════════════════════════════════════════════════════════════

# Gmail SMTP Configuration for Vercel Serverless Function (/api/send-ticket)
# 1. Your Google email account
GMAIL_USER=your_email@gmail.com

# 2. Your 16-character Google App Password (generated via Google Account -> Security -> 2-Step Verification -> App Passwords)
GMAIL_APP_PASS=abcd efgh ijkl mnop

# Admin Dashboard Access PIN (Default fallback in frontend: 2026)
ADMIN_PIN=2026

# Supabase Credentials (Used in index.html client-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
